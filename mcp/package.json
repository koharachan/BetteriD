{
  "name": "betterid-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that drives the BetteriD web editor to draw bus routes, turn spoken descriptions into map edits, and normalize OSM tags",
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "browsers:install": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
