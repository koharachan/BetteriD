# Core service
OSM_LISTEN_ADDR=127.0.0.1:9178
OSM_UPSTREAM_URL=https://www.openstreetmap.org
OSM_TILE_UPSTREAM_URL=https://tile.openstreetmap.org
OSM_ID_DIST_DIR=../dist
OSM_CACHE_DIR=./cache
OSM_CACHE_MAX_SIZE=10000
OSM_CACHE_DEFAULT_TTL=1800
# Routes browser tile images through this proxy so OSM tile requests use the
# BetteriD User-Agent and cache policy instead of a generic browser request.
OSM_PROXY_ALL_TILES=true

# OAuth 2 public client. Register this local callback:
# http://127.0.0.1:9178/id/land.html
OSM_OAUTH_CLIENT_ID=
OSM_OAUTH_REDIRECT_URI=

# Only list exact reverse-proxy IPs that sanitize Forwarded/X-Forwarded-For.
OSM_TRUSTED_PROXY_IPS=
OSM_PHOTO_UPLOAD_DIR=./photo-uploads

# Text providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional DNS override. URL hostname and TLS SNI are preserved.
OPENAI_RESOLVE_IP=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_SEARCH_MODEL=gpt-5.4-mini
OPENAI_MODERATION_MODEL=gpt-5.4-mini
OPENAI_VISION_MODEL=gpt-5.6-sol

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# One or more comma-separated keys, tried silently in order.
MIMO_API_KEYS=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TEXT_MODEL=mimo-v2.5
MIMO_VISION_MODEL=mimo-v2-omni

# Optional Bing translation fallback
BING_TRANSLATE_API_KEY=
BING_TRANSLATE_REGION=global
