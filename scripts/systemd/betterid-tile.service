[Unit]
Description=BetteriD tile proxy (served as wap.map.osm.asia)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/betterid-tile
EnvironmentFile=/opt/betterid-tile/tile.env
ExecStart=/opt/betterid-tile/osm
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
